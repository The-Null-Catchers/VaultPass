# Local development only. Copy to .env; use new credentials outside your laptop.
POSTGRES_USER=vaultpass
POSTGRES_PASSWORD=vaultpass-local-development-only
POSTGRES_DB=vaultpass
DATABASE_URL=postgresql+psycopg://vaultpass:vaultpass-local-development-only@postgres:5432/vaultpass
REDIS_URL=redis://redis:6379/0
ALLOWED_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","api"]
PUBLIC_WEB_URL=http://localhost:3000
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
ENVIRONMENT=development
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=VaultPass <security@localhost>
RATE_LIMIT=20
MAX_REQUEST_BYTES=400000
MAX_VAULT_ITEMS=5000
MAX_ACTIVE_SESSIONS=20
MAX_PASSKEYS=10
MAX_TEAMS_PER_USER=25
MAX_TEAM_MEMBERS=100
AUDIT_RETENTION_DAYS=365
